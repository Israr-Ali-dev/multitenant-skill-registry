# Copy to .env and adjust for local runs. All values below are placeholders — no real secrets.

# --- Postgres (superuser, used only by the container init + Alembic migrations) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-postgres-password
POSTGRES_DB=skill_registry
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Application DB role (non-owner, RLS-enforced; created by migration 0002) ---
APP_DB_USER=app_role
APP_DB_PASSWORD=changeme-app-role-password

# Connection string the API uses at runtime (non-superuser, RLS applies).
DATABASE_URL=postgresql+asyncpg://app_role:changeme-app-role-password@postgres:5432/skill_registry

# Connection string Alembic uses to run migrations (superuser/table-owner).
ADMIN_DATABASE_URL=postgresql+asyncpg://postgres:changeme-postgres-password@postgres:5432/skill_registry

# --- Auth ---
JWT_SECRET=changeme-dev-only-jwt-signing-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- App ---
ENVIRONMENT=local
LOG_LEVEL=INFO
